{
  "_id": "light",
  "name": "Light",
  "themeSource": "light",
  "variables": {
    "--color-scheme": "light",
    "--main-color": "#7C5CFF",
    "--main-color-light": "#9D8CFF",
    "--main-color-deep": "#5B3FD4",
    "--accent-pink": "#F472B6",
    "--link-color": "var(--main-color)",
    "--surface-canvas": "#F5F6FF",
    "--surface-base": "#F5F6FF",
    "--surface-raised": "#FFFFFF",
    "--surface-sunken": "#ECEBFA",
    "--surface-hover": "#E5E2FF",
    "--surface-selected": "color-mix(in srgb, var(--main-color) 10%, transparent)",
    "--text-primary": "#232034",
    "--text-secondary": "#625E76",
    "--border-subtle": "rgba(80, 68, 136, 0.16)",
    "--border-strong": "rgba(80, 68, 136, 0.28)",
    "--accent": "var(--main-color)",
    "--accent-contrast": "#ffffff",
    "--accent-subtle": "color-mix(in srgb, var(--main-color) 10%, transparent)",
    "--accent-border": "color-mix(in srgb, var(--main-color) 28%, transparent)",
    "--focus-color": "#7C5CFF",
    "--radius-sm": "6px",
    "--radius-md": "8px",
    "--shadow-panel": "0 12px 34px rgba(80, 68, 136, 0.14)",
    "--header-shadow": "0 2px 18px rgba(80, 68, 136, 0.12)",
    "--glass-surface": "rgba(255, 255, 255, 0.72)",
    "--glass-surface-solid": "var(--surface-raised)",
    "--glass-backdrop-filter-soft": "blur(16px) saturate(1.15)",
    "--glass-backdrop-filter-strong": "blur(24px) saturate(1.4)",
    "--glass-highlight": "rgba(255, 255, 255, 0.88)",
    "--text": "var(--text-primary)",
    "--text-color": "var(--text-primary)",
    "--text-muted": "#817C96",
    "--font-mono": "Consolas, Monaco, monospace",
    "--text-interactive-bg": "color-mix(in srgb, var(--main-color) 10%, transparent)",
    "--background": "#F5F6FF",
    "--faded-bg": "hsla(0, 0%, 100%, 0.9)",

    "--border-color": "rgba(80, 68, 136, 0.16)",
    "--border-color-softer": "rgba(80, 68, 136, 0.1)",
    "--border-radius": "6px",

    "--header-color": "#333333",
    "--header-bg": "var(--glass-surface)",
    "--header-bg-softer": "var(--surface-raised)",

    "--footer-bg": "var(--glass-surface)",
    "--footer-nav-bg-color-active": "color-mix(in srgb, var(--main-color) 10%, transparent)",

    "--active-item-bg": "color-mix(in srgb, var(--main-color) 10%, transparent)",
    "--active-item-color": "var(--accent)",

    "--tracks-bg-even": "#FFFFFF",
    "--tracks-bg-odd": "#F5F6FF",

    "--tracks-header-bg": "#ECEBFA",
    "--tracks-header-color": "#333333",

    "--cover-bg": "#ECEBFA",

    "--success-color": "hsl(120, 39%, 56%)",
    "--info-color": "hsl(191, 64%, 59%)",
    "--warning-color": "hsl(38, 86%, 62%)",
    "--danger-color": "hsl(7, 70%, 50%)",

    "--toasts-bg": "#ffffff",

    "--progress-bg": "#D9D3F1",

    "--sidebar-bg": "var(--glass-surface)",
    "--sidebar-item-active-bg": "color-mix(in srgb, var(--main-color) 10%, transparent)",

    "--search-bg": "#FFFFFF",
    "--slider-bg": "#D9D3F1",

    "--queue-bg": "var(--glass-surface)",
    "--queue-header-bg": "var(--surface-raised)",

    "--checkbox-bg": "#ECEBFA",
    "--input-bg": "#FFFFFF",
    "--input-color": "var(--text-primary)",
    "--button-bg": "#FFFFFF",
    "--button-border": "rgba(80, 68, 136, 0.16)",
    "--button-color": "var(--text-primary)",
    "--form-control-color": "var(--accent-contrast)"
  }
}
