{
  "_id": "dark",
  "name": "Dark",
  "themeSource": "dark",
  "variables": {
    "--color-scheme": "dark",
    "--main-color": "#7C5CFF",
    "--main-color-light": "#9D8CFF",
    "--main-color-deep": "#5B3FD4",
    "--accent-pink": "#F472B6",
    "--link-color": "var(--main-color)",
    "--surface-canvas": "#0B0E16",
    "--surface-base": "#0B0E16",
    "--surface-raised": "#161522",
    "--surface-sunken": "#10131C",
    "--surface-hover": "#252033",
    "--surface-selected": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--text-primary": "#F4F3FF",
    "--text-secondary": "#A5A8B8",
    "--border-subtle": "rgba(255, 255, 255, 0.12)",
    "--border-strong": "rgba(255, 255, 255, 0.22)",
    "--accent": "var(--main-color)",
    "--accent-contrast": "#ffffff",
    "--accent-subtle": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--accent-border": "color-mix(in srgb, var(--main-color) 42%, transparent)",
    "--focus-color": "#7C5CFF",
    "--radius-sm": "6px",
    "--radius-md": "8px",
    "--shadow-panel": "0 12px 34px rgba(0, 0, 0, 0.38)",
    "--header-shadow": "0 2px 18px rgba(0, 0, 0, 0.28)",
    "--glass-surface": "rgba(255, 255, 255, 0.06)",
    "--glass-surface-solid": "var(--surface-raised)",
    "--glass-backdrop-filter-soft": "blur(16px) saturate(1.15)",
    "--glass-backdrop-filter-strong": "blur(24px) saturate(1.4)",
    "--glass-highlight": "rgba(255, 255, 255, 0.14)",
    "--text": "var(--text-primary)",
    "--text-color": "var(--text-primary)",
    "--text-muted": "#777B8D",
    "--font-mono": "Consolas, Monaco, monospace",
    "--text-interactive-bg": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--background": "#0B0E16",
    "--faded-bg": "hsla(0, 0%, 0%, 0.8)",

    "--border-color": "rgba(255, 255, 255, 0.12)",
    "--border-color-softer": "rgba(255, 255, 255, 0.08)",
    "--border-radius": "6px",

    "--header-color": "var(--text-primary)",
    "--header-bg": "var(--glass-surface)",
    "--header-bg-softer": "var(--surface-raised)",

    "--footer-bg": "var(--glass-surface)",
    "--footer-nav-bg-color-active": "color-mix(in srgb, var(--main-color) 15%, transparent)",

    "--active-item-bg": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--active-item-color": "var(--accent)",

    "--tracks-bg-even": "#0B0E16",
    "--tracks-bg-odd": "#10131C",

    "--tracks-header-bg": "#10131C",
    "--tracks-header-color": "var(--text-primary)",

    "--cover-bg": "#161522",

    "--success-color": "hsl(120, 39%, 56%)",
    "--info-color": "hsl(191, 64%, 59%)",
    "--warning-color": "hsl(38, 86%, 62%)",
    "--danger-color": "hsl(7, 70%, 62%)",

    "--toasts-bg": "#1d1d1d",

    "--progress-bg": "#373145",

    "--sidebar-bg": "var(--glass-surface)",
    "--sidebar-item-active-bg": "color-mix(in srgb, var(--main-color) 15%, transparent)",

    "--search-bg": "#161522",
    "--slider-bg": "#373145",

    "--queue-bg": "var(--glass-surface)",
    "--queue-header-bg": "var(--surface-raised)",

    "--checkbox-bg": "#161522",
    "--input-bg": "#161522",
    "--input-color": "var(--text-primary)",
    "--button-bg": "#161522",
    "--button-border": "rgba(255, 255, 255, 0.12)",
    "--button-color": "var(--text-primary)",
    "--form-control-color": "var(--accent-contrast)"
  }
}
