{
  "_id": "dark",
  "name": "Dark",
  "themeSource": "dark",
  "variables": {
    "--color-scheme": "dark",
    "--main-color": "#FF69B4",
    "--link-color": "var(--main-color)",
    "--surface-canvas": "#121212",
    "--surface-raised": "#1a1a1a",
    "--surface-sunken": "#1d1d1d",
    "--surface-hover": "#363636",
    "--surface-selected": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--text-primary": "#e1e1e1",
    "--text-secondary": "#999999",
    "--border-subtle": "#333333",
    "--border-strong": "#4a4a4a",
    "--accent": "var(--main-color)",
    "--accent-contrast": "#ffffff",
    "--accent-subtle": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--accent-border": "color-mix(in srgb, var(--main-color) 42%, transparent)",
    "--focus-color": "#FF69B4",
    "--radius-sm": "6px",
    "--radius-md": "8px",
    "--shadow-panel": "0 8px 16px rgba(0, 0, 0, 0.4)",
    "--header-shadow": "0 2px 14px rgba(0, 0, 0, 0.32)",
    "--text": "var(--text-primary)",
    "--text-color": "var(--text-primary)",
    "--text-muted": "#777777",
    "--font-mono": "Consolas, Monaco, monospace",
    "--text-interactive-bg": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--background": "#121212",
    "--faded-bg": "hsla(0, 0%, 0%, 0.8)",

    "--border-color": "#333333",
    "--border-color-softer": "#2a2a2a",
    "--border-radius": "6px",

    "--header-color": "var(--text-primary)",
    "--header-bg": "#181818",
    "--header-bg-softer": "#1d1d1d",

    "--footer-bg": "rgba(18, 18, 18, 0.86)",
    "--footer-nav-bg-color-active": "color-mix(in srgb, var(--main-color) 15%, transparent)",

    "--active-item-bg": "color-mix(in srgb, var(--main-color) 15%, transparent)",
    "--active-item-color": "var(--accent)",

    "--tracks-bg-even": "#121212",
    "--tracks-bg-odd": "#1d1d1d",

    "--tracks-header-bg": "#121212",
    "--tracks-header-color": "var(--text-primary)",

    "--cover-bg": "#1d1d1d",

    "--success-color": "hsl(120, 39%, 56%)",
    "--info-color": "hsl(191, 64%, 59%)",
    "--warning-color": "hsl(38, 86%, 62%)",
    "--danger-color": "hsl(7, 70%, 62%)",

    "--toasts-bg": "#1d1d1d",

    "--progress-bg": "#4a4a4a",

    "--sidebar-bg": "#1a1a1a",
    "--sidebar-item-active-bg": "color-mix(in srgb, var(--main-color) 15%, transparent)",

    "--search-bg": "#2a2a2a",
    "--slider-bg": "#4a4a4a",

    "--queue-bg": "#1d1d1d",
    "--queue-header-bg": "#1a1a1a",

    "--checkbox-bg": "#2a2a2a",
    "--input-bg": "#2a2a2a",
    "--input-color": "var(--text-primary)",
    "--button-bg": "#1d1d1d",
    "--button-border": "#333333",
    "--button-color": "var(--text-primary)",
    "--form-control-color": "var(--accent-contrast)"
  }
}
